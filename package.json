{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "Root helper scripts for TaskFlow. The app code lives in server/ and client/.",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently --names server,client --prefix-colors blue,green --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "license": "MIT"
}
