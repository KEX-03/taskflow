# Copy this file to .env and adjust the values. Never commit your real .env file.

# Port the API listens on (hosts like Render set this for you).
PORT=5000

# MongoDB connection string: a local database, or your MongoDB Atlas URI (mongodb+srv://...).
MONGO_URI=mongodb://localhost:27017/taskflow

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# How long a login token stays valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this API (CORS). Separate several with commas,
# e.g. http://localhost:3000,https://my-app.vercel.app. Defaults to http://localhost:3000 if unset.
FRONTEND_ORIGIN=http://localhost:3000
